{
  "name": "dosye-business",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Досье — проверка компаний и предпринимателей России",
  "author": "Dosye",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "dist-electron/main.cjs",
  "scripts": {
    "setup:desktop": "install-electron",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:desktop": "playwright test --config playwright.electron.config.ts",
    "test:live": "npm run build && node scripts/check-live.mjs",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "dist:portable": "npm run build && electron-builder --win portable --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux dir --x64 --publish never"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "ru.dosye.business",
    "productName": "Dosye",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asar": true,
    "toolsets": {
      "wine": "1.0.1"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "Dosye-${version}-Setup-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Досье"
    },
    "portable": {
      "artifactName": "Dosye-${version}-Portable-${arch}.${ext}"
    }
  }
}
